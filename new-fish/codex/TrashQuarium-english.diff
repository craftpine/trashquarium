+// English names and facts for the species roster, keyed by species id
+// (src-tauri/config/species.json). `npm run test:i18n` checks every species has an entry.
+export const SPECIES_EN: Record<string, { name: string; fact: string }> = {
+  cyprinus_carpio: { name: "Common carp", fact: "Common carp have barbels near the mouth; don't mistake every goldfish for a carp." },
+  carassius_auratus: { name: "Goldfish", fact: "The goldfish is Carassius auratus; in the aquarium trade its colours and fin shapes vary enormously." },
+  poecilia_reticulata: { name: "Guppy", fact: "Guppies give birth to live young. Eggs in this game are only a symbol for the wait for the fry." },
+  betta_splendens: { name: "Betta", fact: "The betta is Betta splendens. The shared tank in this game is not a guide to keeping fish together." },
+  paracheirodon_innesi: { name: "Neon tetra", fact: "The neon tetra is Paracheirodon innesi; it is not the green neon tetra." },
+  pterophyllum_scalare: { name: "Freshwater angelfish", fact: "The freshwater angelfish is Pterophyllum scalare." },
+  danio_rerio: { name: "Zebrafish", fact: "The zebrafish, Danio rerio, is a species widely used in biology research." },
+  xiphophorus_hellerii: { name: "Green swordtail", fact: "Swordtails bear live young. The sword-like tail extension is usually seen on males." },
+  trichopodus_leerii: { name: "Pearl gourami", fact: "The scientific name of the pearl gourami is Trichopodus leerii." },
+  symphysodon_aequifasciatus: { name: "Discus", fact: "This entry illustrates Symphysodon aequifasciatus; opinions differ on how to classify the discus group." },
+  synchiropus_splendidus: { name: "Mandarinfish", fact: "The mandarinfish grows to only about 7 cm and lives in shallow lagoons and inshore reefs with muddy bottoms and coral rubble." },
+  pomacanthus_imperator: { name: "Emperor angelfish", fact: "The emperor angelfish feeds mostly on sponges and encrusting animals; juveniles and adults sometimes clean much larger fish." },
+  holacanthus_ciliaris: { name: "Queen angelfish", fact: "Stomach samples show the queen angelfish eats almost nothing but sponges; juveniles pick parasites off other fish." },
+  chaetodon_auriga: { name: "Threadfin butterflyfish", fact: "The threadfin butterflyfish nips at bristle worms, anemones, coral polyps and algae; pairs form when they spawn." },
+  centropyge_loriculus: { name: "Flame angelfish", fact: "The flame angelfish eats algae, stays near cover and often forms harems of 3–7 fish." },
+  gramma_loreto: { name: "Royal gramma", fact: "The royal gramma swims with its belly toward the rock, so under a ledge it looks like it is swimming upside down; the male guards the nest." },
+  nemateleotris_magnifica: { name: "Firefish goby", fact: "The firefish hovers above the bottom facing the current to snap up plankton, and often flicks its first dorsal fin like a flag." },
+  pterapogon_kauderni: { name: "Banggai cardinalfish", fact: "The male carries the eggs in his mouth until the young are about 8 mm long; the young have no drifting stage." },
+  sphaeramia_nematoptera: { name: "Pajama cardinalfish", fact: "Pajama cardinalfish school among Porites coral branches in sheltered bays and spread out to feed near the bottom at night; they brood eggs in the mouth." },
+  pseudocheilinus_hexataenia: { name: "Six-line wrasse", fact: "The six-line wrasse reaches about 10 cm, is shy and often swims between coral branches to hide." },
+  cheilinus_undulatus: { name: "Humphead wrasse", fact: "The humphead wrasse can grow beyond 2 m and is one of the few animals that eats toxic prey such as sea hares, boxfish and crown-of-thorns starfish." },
