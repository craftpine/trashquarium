+  myoxocephalus_scorpius: { name: "Shorthorn sculpin", fact: "Shorthorn sculpins have a big, spiny head; males guard the eggs, and they hunt crabs, shrimp and small fish." },
+  taurulus_bubalis: { name: "Long-spined sea scorpion", fact: "Long-spined sea scorpions have a long spine on the gill cover and change colour to match the rocks and weed around them." },
+  cepola_macrophthalma: { name: "Red bandfish", fact: "Red bandfish have a long ribbon-like body, live in vertical burrows in mud and lean out to catch plankton." },
+  chelidonichthys_cuculus: { name: "Red gurnard", fact: "Red gurnards \"walk\" on the seabed on three free pectoral rays and can grunt using their swim bladder." },
+  eutrigla_gurnardus: { name: "Grey gurnard", fact: "Grey gurnards feel for prey in the sand with free pectoral rays and are the commonest gurnard in the North Sea." },
+  hyperoplus_lanceolatus: { name: "Greater sand eel", fact: "The greater sand eel isn't an eel but a slender fish that dives into sand to escape predators." },
+  belone_belone: { name: "Garfish", fact: "Garfish have long, beak-like jaws full of needle teeth, and their bones are green." },
+  syngnathus_acus: { name: "Greater pipefish", fact: "Greater pipefish are seahorse relatives; the male carries the eggs in a brood pouch until they hatch." },
 };
