+  tripterygion_delaisi: { name: "Black-faced blenny", fact: "Black-faced blennies have three dorsal fins; in the breeding season males turn bright yellow with a black face." },
+  gobius_niger: { name: "Black goby", fact: "Black gobies like muddy bottoms and seagrass in estuaries; males guard eggs stuck under shells or stones." },
+  gobius_paganellus: { name: "Rock goby", fact: "Rock gobies hide under stones in rock pools; the first dorsal fin has a pale band along its top." },
+  gobius_cobitis: { name: "Giant goby", fact: "Giant gobies reach up to 27 cm, making them one of the largest gobies on European shores." },
