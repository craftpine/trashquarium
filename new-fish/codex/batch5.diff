+  pomatoschistus_flavescens: { name: "Two-spotted goby", fact: "Two-spotted gobies have a dark spot at the tail base (males add one behind the pectoral fin) and hover among seaweed." },
+  thorogobius_ephippiatus: { name: "Leopard-spotted goby", fact: "Leopard-spotted gobies are covered in dark-edged orange blotches and are shy, hiding in rock crevices." },
+  liparis_liparis: { name: "Common seasnail", fact: "Common seasnails have soft, scaleless skin and pelvic fins turned into a sucker for clinging to rocks." },
+  cyclopterus_lumpus: { name: "Lumpsucker", fact: "Lumpsuckers have a sucker on the belly; males guard egg clumps on shore rocks and fan them with water." },
